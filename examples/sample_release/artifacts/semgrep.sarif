{
  "version": "2.1.0",
  "$schema": "http./sample_release",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "semgrep",
          "semanticVersion": "1.70.0",
          "informationUri": "http./sample_release"
        }
      },
      "results": [
        {
          "ruleId": "python.lang.security.audit.dangerous-system-call.dangerous-system-call",
          "level": "warning",
          "message": { "text": "Potential command injection via os.system" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/payments/handler.py" },
                "region": { "startLine": 42 }
              }
            }
          ]
        },
        {
          "ruleId": "python.lang.best-practice.logging-format",
          "level": "note",
          "message": { "text": "Prefer f-strings for logging calls" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/payments/logger.py" },
                "region": { "startLine": 12 }
              }
            }
          ]
        }
      ]
    }
  ]
}
