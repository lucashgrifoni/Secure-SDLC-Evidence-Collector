{
  "version": "2.1.0",
  "$schema": "http./sample_release",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "trivy",
          "semanticVersion": "0.52.0",
          "informationUri": "http./sample_release"
        }
      },
      "results": [
        {
          "ruleId": "CVE-2024-12345",
          "level": "warning",
          "message": { "text": "requests 2.30.0 is affected by CVE-2024-12345" }
        }
      ]
    }
  ]
}
