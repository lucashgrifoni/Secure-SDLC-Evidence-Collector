                "precision": "very-high",
                "security-severity": "4.8",
                "tags": [
                  "vulnerability",
                  "security",
                  "MEDIUM"
                ]
              }
            },
            {
              "id": "CVE-2026-40175",
              "name": "LanguageSpecificPackageVulnerability",
              "shortDescription": {
                "text": "axios: Axios: Remote Code Execution via Prototype Pollution escalation"
              },
              "fullDescription": {
                "text": "Axios is a promise based HTTP client for the browser and Node.js. Prior to 1.15.0 and 0.3.1, the Axios library is vulnerable to a specific \"Gadget\" attack chain that allows Prototype Pollution in any third-party dependency to be escalated into Remote Code Execution (RCE) or Full Cloud Compromise (via AWS IMDSv2 bypass). This vulnerability is fixed in 1.15.0 and 0.3.1."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "http./02-identity-admin-lab",
              "help": {
                "text": "Vulnerability CVE-2026-40175\nSeverity: MEDIUM\nPackage: axios\nFixed Version: 1.15.0, 0.31.0\nLink: [CVE-2026-40175](http./02-identity-admin-lab is a promise based HTTP client for the browser and Node.js. Prior to 1.15.0 and 0.3.1, the Axios library is vulnerable to a specific \"Gadget\" attack chain that allows Prototype Pollution in any third-party dependency to be escalated into Remote Code Execution (RCE) or Full Cloud Compromise (via AWS IMDSv2 bypass). This vulnerability is fixed in 1.15.0 and 0.3.1.",
                "markdown": "**Vulnerability CVE-2026-40175**\n| Severity | Package | Fixed Version | Link |\n| --- | --- | --- | --- |\n|MEDIUM|axios|1.15.0, 0.31.0|[CVE-2026-40175](http./02-identity-admin-lab is a promise based HTTP client for the browser and Node.js. Prior to 1.15.0 and 0.3.1, the Axios library is vulnerable to a specific \"Gadget\" attack chain that allows Prototype Pollution in any third-party dependency to be escalated into Remote Code Execution (RCE) or Full Cloud Compromise (via AWS IMDSv2 bypass). This vulnerability is fixed in 1.15.0 and 0.3.1."
              },
              "properties": {
                "cvssv3_baseScore": 4.8,
                "cvssv3_vector": "CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:L/I:L/A:N",
                "precision": "very-high",
