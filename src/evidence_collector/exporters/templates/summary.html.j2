  .why li { position: relative; padding: 5px 0 5px 18px; font-size: 0.93rem; }
  .why li::before { content: ""; position: absolute; left: 0; top: 0.95em; width: 8px; border-top: 1px solid var(--accent); }
  .why .caution { display: flex; align-items: baseline; gap: 8px; padding-left: 0; color: var(--text-hi); }
  .why .caution::before { content: none; }
  .why .caution .i { color: var(--warn-ink); position: relative; top: 0.12em; }
  /* Each group label starts its own line, so the critical group, which blocks
