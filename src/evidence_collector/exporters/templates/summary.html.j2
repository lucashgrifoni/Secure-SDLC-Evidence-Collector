  }
  .verdict[data-verdict="ready"] { --v-ink: var(--ok-ink); --v-strong: var(--ok-strong); --v-fill: var(--ok-fill); --v-glow: var(--ok-glow); --v-tint: var(--ok-tint); --v-line: var(--ok-line); }
