{#-
  Release evidence summary: one self-contained file, no script, no request.
  Contracts this template keeps (tests/unit/test_exporters.py, the
  summary_html tests and the integration tests read the page as text):
  - every section heading is a bare <h2>, with no attribute, so a section can
    be sliced from one heading to the next. Headings inside the verdict panel
    carry a class and are not section headings;
  - "Approved exceptions" and "Exceptions not in force" appear only when
    their section does;
  - the Controls measure is `<div class="label">Controls</div>` followed by a
    `<div class="meta">` that holds the breakdown as plain text;
  - `status-<verdict>` is written once, on the verdict panel. The styles
    select on `data-verdict`, so the other two class names are absent and the
    assertion on the verdict class is a real one;
  - every status pill holds an icon and a word, and nothing else;
  - "manual attestation" is written only for a manual evidence record.
  Every bundle string goes through autoescape as a text node. Nothing here is
  marked safe, no bundle string reaches an attribute that is not a text
  attribute, and row anchors are loop positions, never identifiers.
  Optional context, each rendered only when the caller passes it:
  `collector_version`, `bundle_digest` and `ignored_inputs` (its length only).
  Provenance shown: tag, full commit, artifact digest, pipeline run and build
  ids. Not shown: artifact file paths, per-evidence hashes, owner_team,
  waiver justification and approved_at (owner decision, 2026-11-13).
-#}
{% set summary = bundle.summary %}
{% set verdict = summary.release_status.value %}
{% set risk = summary.risk_assessment %}
{% set errors = bundle.collection_errors or [] %}
{% set exceptions_in_force, exceptions_not_in_force = split_exceptions(bundle) %}
{% set levels = ["critical", "high", "medium", "low"] %}
{#- The release-anchor drift check can degrade the verdict after the risk mode
    ran, so the final verdict alone does not say the risk mode moved it. -#}
{% set risk_moved = (risk_weighted_status(risk) != risk.base_release_status) if risk else false %}
{% set custom_catalog = (bundle.catalog.origin == "custom") if bundle.catalog else false %}
{#- Controls most critical first: the tile map and the table share this order,
    so a tile and its row carry the same position. -#}
{% set controls = [] %}
{% for level in levels %}
  {% for evaluation in bundle.control_evaluations if evaluation.criticality.value == level %}
    {% set _ = controls.append(evaluation) %}
  {% endfor %}
{% endfor %}
{#- Row positions for the cross-links, and the controls each record supports. -#}
{% set control_row = {} %}
{% set control_level = {} %}
{% set control_status = {} %}
{% set evidence_row = {} %}
{% set exception_row = {} %}
{% set supports = {} %}
{% for evaluation in controls %}
  {% set _ = control_row.setdefault(evaluation.control_id, loop.index) %}
  {% set _ = control_level.setdefault(evaluation.control_id, evaluation.criticality.value) %}
  {% set _ = control_status.setdefault(evaluation.control_id, evaluation.evaluation_status.value) %}
  {% for ref in evaluation.evidence_refs %}
    {% set _ = supports.setdefault(ref, []).append(evaluation.control_id) %}
  {% endfor %}
{% endfor %}
{% for item in bundle.evidence %}
  {% set _ = evidence_row.setdefault(item.evidence_id, loop.index) %}
{% endfor %}
{% for exception in exceptions_in_force %}
  {% set _ = exception_row.setdefault(exception.exception_id, loop.index) %}
{% endfor %}
{% set gap_count = {} %}
{% for level in levels %}
  {% set _ = gap_count.update({level: bundle.gaps | selectattr("criticality", "equalto", level) | list | length}) %}
{% endfor %}
{% set urgent_gaps = gap_count.critical + gap_count.high %}
{% set exception_total = exceptions_in_force | length + exceptions_not_in_force | length %}
{#- The controls the confidence score averages over, and their mix. -#}
{% set backed = bundle.control_evaluations | selectattr("evaluation_status.value", "in", ["met", "partial", "waived"]) | list %}
{% set strength_mix = [] %}
{% for level in ["high", "medium", "low"] %}
  {% set count = backed | selectattr("confidence.value", "equalto", level) | list | length %}
  {% if count %}{% set _ = strength_mix.append((level, count)) %}{% endif %}
{% endfor %}
{% set control_counts = [] %}
{% for name, count in [("met", summary.controls_met), ("partial", summary.controls_partial), ("missing", summary.controls_missing), ("waived", summary.controls_waived), ("not_applicable", summary.controls_not_applicable)] if count %}
  {% set _ = control_counts.append((name, count)) %}
{% endfor %}
{% set provenance = [("tag", bundle.release.tag, "--tag"), ("artifact digest", bundle.release.artifact_digest, "--artifact-digest"), ("pipeline run", bundle.release.pipeline_run_id, "--pipeline-run-id"), ("build", bundle.release.build_id, "--build-id")] %}
{% set unrecorded = provenance | rejectattr(1) | list %}
{% set verdict_word = {"ready": "Ready", "conditional": "Conditional", "not_ready": "Not ready"} %}
{% set verdict_tone = {"ready": "ok", "conditional": "warn", "not_ready": "bad"} %}
{% set verdict_meaning = {
  "ready": "Every control is met, waived or not applicable.",
  "conditional": "No critical control lacks required evidence, but at least one control is partial or missing, or supplied evidence was set aside.",
  "not_ready": "A critical control lacks required evidence.",
} %}
{#- What a gap of each level does to the verdict, as the scoring engine
    decides it: a critical gap makes the release not_ready, and any control
    left missing or partial keeps it conditional at best. A waiver turns its
    control's gaps into low ones that no longer count. -#}
{% set gap_note = {
  "critical": "each one makes the release not_ready",
  "high": "each one keeps the release conditional at best",
  "medium": "each one keeps the release conditional at best",
  "low": "each one keeps the release conditional at best unless a waiver covers its control",
} %}
{% set control_tone = {"met": "ok", "partial": "warn", "missing": "bad", "waived": "muted", "not_applicable": "muted"} %}
{% set control_glyph = {"met": "met", "partial": "partial", "missing": "missing", "waived": "waived", "not_applicable": "na"} %}
{% set evidence_tone = {"passed": "ok", "completed": "ok", "generated": "ok", "failed": "bad", "invalid": "bad", "missing": "bad"} %}
{% set tone_glyph = {"ok": "met", "warn": "partial", "bad": "missing", "muted": "dot"} %}
{% set level_tone = {"critical": "bad", "high": "warn", "other": "muted"} %}
{% macro icon(name) -%}
<svg class="i" aria-hidden="true" focusable="false"><use href="#i-{{ name }}"/></svg>
{%- endmacro %}
{% macro pill(word, tone, glyph) -%}
<span class="pill" data-tone="{{ tone }}">{{ icon(glyph) }}{{ word }}</span>
{%- endmacro %}
{#- Engine text marks identifiers with backticks. Balanced pairs become <code>;
    anything else is written as it came. Each part is escaped on its own. -#}
{% macro ticked(text) -%}
{%- set parts = (text or "").split("`") -%}
{%- if parts | length is odd -%}
{%- for part in parts -%}
{%- if loop.index0 is odd -%}<code>{{ part }}</code>{%- else -%}{{ part }}{%- endif -%}
{%- endfor -%}
{%- else -%}{{ text }}{%- endif -%}
{%- endmacro %}
{% macro control_link(control_id) -%}
{%- if control_id in control_row -%}
<a class="ref" href="#ctl-{{ control_row[control_id] }}"><code>{{ control_id }}</code></a>
{%- else -%}<code>{{ control_id }}</code>{%- endif -%}
{%- endmacro %}
{#- Bars are drawn in viewBox units, so they need no style attribute. A bar
    of counted parts has a cut in the sheet colour between two parts. -#}
{% macro meter(value) -%}
<svg class="meter" viewBox="0 0 100 1" preserveAspectRatio="none" aria-hidden="true" focusable="false"><rect class="track" width="100" height="1"/><rect class="fill" width="{{ value | int }}" height="1"/></svg>
{%- endmacro %}
{% macro parts_bar(parts, prefix) -%}
{%- set drawn = parts | sum(attribute=1) -%}
{%- set cursor = namespace(x=0) -%}
<svg class="meter" viewBox="0 0 {{ [drawn, 1] | max | int }} 1" preserveAspectRatio="none" aria-hidden="true" focusable="false"><rect class="track" width="{{ [drawn, 1] | max | int }}" height="1"/>
{%- for name, count in parts -%}
<rect class="{{ prefix }}-{{ name }}" x="{{ cursor.x | int }}" width="{{ count | int }}" height="1"/>
{%- if not loop.first %}<line class="cut" x1="{{ cursor.x | int }}" x2="{{ cursor.x | int }}" y1="0" y2="1"/>{% endif -%}
{%- set cursor.x = cursor.x + count -%}
{%- endfor -%}
</svg>
{%- endmacro %}
{#- The missing items in flat positions [first, last), critical first, each
    group under its own label. Called twice: the first few in the verdict
    panel, the rest inside a disclosure, so a long list does not push the
    next step below the first screen of a phone. -#}
{% macro missing_chips(by_level, first, last) -%}
{%- set position = namespace(offset=0) -%}
{%- for label, key in [("critical, blocks the release", "critical"), ("high", "high"), ("not in the control list", "other")] -%}
{%- set items = by_level[key] -%}
{%- set shown = items[[first - position.offset, 0] | max : [last - position.offset, 0] | max] -%}
{%- if shown %}
<span class="chips-label">{{ label }}</span>
<span class="chips">
{% for item in shown %}
{% set control_id, _, evidence_type = item.rpartition(":") if ":" in item else (item, "", "") %}
{% if control_id in control_row %}<a class="chip" data-tone="{{ level_tone[key] }}" href="#ctl-{{ control_row[control_id] }}">{% else %}<span class="chip" data-tone="{{ level_tone[key] }}">{% endif %}<b>{{ control_id }}</b>{% if evidence_type %}<span>{{ evidence_type }}</span>{% endif %}{% if control_id in control_row %}</a>{% else %}</span>{% endif %}
{% endfor %}
</span>
{%- endif -%}
{%- set position.offset = position.offset + items | length -%}
{%- endfor -%}
{%- endmacro %}
