  .why .caution .i { position: relative; top: 0.12em; color: var(--warn-ink); }
  /* Each group label starts its own line, so the critical group, which blocks
     the release, never shares a row with the high group. */
  .chips-label { display: block; margin-top: 8px; font: 500 0.6875rem var(--mono); color: var(--text-lo); }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; }
  .chip {
    display: inline-flex;
    flex-direction: column;
    gap: 2px;
    min-height: 24px;
    padding: 6px 9px;
    font: 0.75rem/1.2 var(--mono);
    color: var(--c);
    text-decoration: none;
    background: var(--t);
    border: 1px solid var(--l);
    border-radius: var(--r-2);
    overflow-wrap: anywhere;
  }
  .chip b { font-weight: 600; }
  .chip span { font-size: 0.6875rem; color: var(--text); }
  a.chip:hover { border-color: var(--c); }
  .more { margin-top: 8px; }
  .tag { display: inline-block; margin-left: 6px; padding: 1px 8px; font: 500 0.7rem/1.5 var(--mono); color: var(--v-ink); border: 1px solid var(--v-line); border-radius: 999px; white-space: nowrap; }
  .next p { margin-top: 10px; color: var(--text-hi); }

  .metrics { display: grid; border: 1px solid var(--line); border-radius: var(--r-4); background: var(--sheet); overflow: hidden; }
  .metric { position: relative; display: grid; align-content: start; gap: 8px; padding: 18px 20px; }
  .metric + .metric { border-top: 1px solid var(--line); }
  .num { font-size: 2.125rem; font-weight: 700; line-height: 1; color: var(--text-hi); font-variant-numeric: tabular-nums; }
  .unit { margin-left: 3px; font: 500 0.8125rem var(--mono); color: var(--text-lo); }
  .hint { font-size: 0.8125rem; color: var(--text-lo); }
  .meter { display: block; width: 100%; height: 8px; border-radius: 999px; overflow: hidden; }
  .meter .track { fill: var(--track); }
  .meter .fill { fill: var(--meter-a); }
  .meter .cut { stroke: var(--sheet); stroke-width: 2px; vector-effect: non-scaling-stroke; }
  .seg-met, .mix-high { fill: var(--ok-fill); }
  .seg-partial { fill: var(--warn-fill); }
  .seg-missing { fill: var(--bad-fill); }
  .seg-waived, .seg-not_applicable, .mix-low { fill: var(--muted-fill); }
  .mix-medium { fill: var(--text-lo); }
  .legend { display: flex; flex-wrap: wrap; gap: 6px 12px; }
  .legend span { display: inline-flex; align-items: center; gap: 4px; font: 600 0.75rem var(--mono); color: var(--c); }

  /* Sections */
  .block { margin-top: 34px; }
  .head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 14px; margin-bottom: 12px; }
  .head h2 { font-size: 1.375rem; font-weight: 700; line-height: 1.2; letter-spacing: -0.01em; color: var(--text-hi); }
  .lede { max-width: 86ch; font-size: 0.875rem; color: var(--text-lo); }
  .callout { display: flex; gap: 12px; margin-bottom: 12px; padding: 14px 16px; color: var(--text-hi); background: var(--warn-tint); border: 1px solid var(--warn-line); border-radius: var(--r-3); }
  .callout .i { width: 1.2em; height: 1.2em; margin-top: 0.15em; color: var(--warn-ink); }
  .callout p { max-width: 80ch; font-size: 0.93rem; }
  .empty { display: flex; align-items: center; gap: 8px; padding: 14px 16px; color: var(--text-lo); background: var(--sheet); border: 1px solid var(--line); border-radius: var(--r-3); }
  .empty[data-tone] { color: var(--c); }
  .flag { display: inline-flex; align-items: center; gap: 5px; padding: 0 8px; font: 500 0.74rem/1.6 var(--mono); color: var(--warn-ink); background: var(--warn-tint); border: 1px solid var(--warn-line); border-radius: 999px; }

  /* Controls at a glance: one tile per control, each a link to its row. */
  .tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(205px, 1fr)); gap: 10px; }
  .tiles li { display: grid; min-width: 0; }
  .tile { display: grid; gap: 6px; min-width: 0; padding: 12px 13px; color: var(--text); text-decoration: none; background: var(--sheet); border: 1px solid var(--line); border-top: 3px solid var(--f); border-radius: var(--r-3); }
  .tile:hover { border-color: var(--l); border-top-color: var(--f); }
  .tile-top { display: flex; align-items: center; gap: 7px; color: var(--c); }
  .tile-top b { min-width: 0; font: 600 0.8125rem var(--mono); color: var(--text-hi); overflow-wrap: anywhere; }
  .tile-name { display: -webkit-box; min-height: 2.7em; overflow: hidden; font-size: 0.8125rem; line-height: 1.35; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  .tile-foot { display: flex; justify-content: space-between; gap: 8px; font: 500 0.6875rem var(--mono); color: var(--text-lo); }
  .tile-foot .st { color: var(--c); }

  /* Gaps, grouped by the weight each one carries on the verdict. */
  .gapgroup { margin-top: 10px; background: var(--sheet); border: 1px solid var(--line); border-radius: var(--r-3); overflow: hidden; }
  .gapgroup h3 { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; padding: 11px 16px; font-size: 0.9375rem; color: var(--text-hi); background: var(--sheet-head); border-bottom: 1px solid var(--line); }
  .gapgroup h3 small { font: 500 0.75rem var(--mono); color: var(--text-lo); }
  .g-critical h3 { color: var(--bad-ink); box-shadow: inset 3px 0 0 var(--bad-fill); }
  .g-high h3 { color: var(--warn-ink); box-shadow: inset 3px 0 0 var(--warn-fill); }
  .gapgroup li { display: grid; grid-template-columns: minmax(0, 13rem) minmax(0, 11rem) minmax(0, 1fr); gap: 12px; align-items: start; padding: 10px 16px; border-top: 1px solid var(--line); }
  .gapgroup li:first-child { border-top: 0; }
  .gapgroup li p { font-size: 0.875rem; }
  .gapgroup .ref code { padding-left: 0; padding-right: 0; font-weight: 600; background: none; text-decoration: none; }
  .etype { justify-self: start; padding: 3px 8px; font: 0.75rem/1.4 var(--mono); color: var(--text); background: var(--code-bg); border-radius: 6px; overflow-wrap: anywhere; }

  /* A sheet scrolls sideways instead of cutting a column off: if a table is
     ever wider than its sheet, every column stays reachable (keyboard
     included, through tabindex on the region). The card layout below keeps
     the known content from needing it. */
  .sheet { border: 1px solid var(--line); border-radius: var(--r-3); background: var(--sheet); overflow-x: auto; }
  .sheet:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
  th, td { padding: 11px 14px; text-align: left; vertical-align: top; font-weight: 400; border-top: 1px solid var(--line); overflow-wrap: break-word; }
  /* Cells that carry free text from the bundle wrap `anywhere`: unlike
     `break-word`, it lowers the cell's minimum width, so one long unbroken
     value cannot widen the whole table. Short enumerated values (framework,
     status, dates) keep `break-word` and never split inside a word. */
  td.wide, th.wide, .free { overflow-wrap: anywhere; }
  thead th { font: 600 0.6875rem/1.4 var(--mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-lo); background: var(--sheet-head); border-top: 0; white-space: nowrap; }
  tbody tr:first-child > * { border-top: 0; }
  tbody tr:target { background: var(--target); }
  tr { scroll-margin-top: 76px; }
  .k { display: none; }
  .c-main { min-width: 15rem; }
  .c-ref { min-width: 11.5rem; }
  .lead code { padding: 0; font-weight: 600; background: none; }
  .crit { font: 600 0.75rem var(--mono); color: var(--text-lo); }
  .crit[data-level="critical"] { color: var(--bad-ink); }
  .crit[data-level="high"] { color: var(--warn-ink); }
  .refs .ref, .refs > code { display: inline-block; margin: 0 4px 4px 0; }
  .supports, .waiver { display: block; margin-top: 4px; font-size: 0.8rem; color: var(--text-lo); }

  details { margin-top: 6px; }
  summary { display: inline-flex; align-items: center; gap: 8px; min-height: 24px; font: 500 0.72rem var(--mono); color: var(--text-lo); cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary::before { content: "+"; display: grid; place-items: center; width: 16px; height: 16px; font-size: 0.8rem; line-height: 1; color: var(--accent-ink); border: 1px solid var(--accent-line); border-radius: var(--r-1); }
  details[open] > summary::before { content: "\2212"; }
  details p { margin-top: 4px; max-width: 70ch; font-size: 0.84rem; color: var(--text-lo); }

  /* Exceptions and the record */
  .exc { background: var(--sheet); border: 1px solid var(--line); border-radius: var(--r-3); }
  .exc li { padding: 12px 16px; border-top: 1px solid var(--line); scroll-margin-top: 76px; }
  .exc li:first-child { border-top: 0; }
  .exc li:target { background: var(--target); }
  .rec { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); border: 1px solid var(--line); border-radius: var(--r-3); background: var(--sheet); overflow: hidden; }
  .rec > div { min-width: 0; padding: 13px 16px; box-shadow: -1px 0 0 var(--line), 0 -1px 0 var(--line); }
  .rec dt { font: 600 0.6875rem var(--mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-lo); }
  .rec dd { margin-top: 5px; font-weight: 600; color: var(--text-hi); overflow-wrap: anywhere; }
  .rec dd .sub { font-weight: 400; }
  .lack { margin-top: 10px; font-size: 0.8125rem; color: var(--text-lo); }

  footer { margin-top: 34px; padding-block: 18px 40px; font-size: 0.8125rem; color: var(--text-lo); border-top: 1px solid var(--line); }
  footer p + p, footer .kv { margin-top: 6px; }
  .kv { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 3px 12px; }
  .kv dt { font-family: var(--mono); font-size: 0.74rem; }

  @media (max-width: 900px) {
    .hero { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 700px) {
    html { scroll-padding-top: 104px; }
    tr, .exc li { scroll-margin-top: 104px; }
    .wrap { padding: 0 16px; }
    .bar nav { width: 100%; margin-left: 0; overflow-x: auto; }
    .bar nav ul { flex-wrap: nowrap; }
    .verdict { padding: 22px 18px; }
    .cols { grid-template-columns: minmax(0, 1fr); }
    .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .gapgroup li { grid-template-columns: minmax(0, 1fr); gap: 6px; }
  }

  /* Below the width at which the widest known table (Controls of a real
     not_ready bundle) fits its sheet, a row becomes a card of labelled
     lines, so nothing scrolls sideways on a tablet or a zoomed desktop
     either. The roles written on the table elements keep them a table for
     assistive technology after `display` changes. */
  @media screen and (max-width: 1000px) {
    table, tbody, tr, th, td { display: block; }
    .c-main, .c-ref { min-width: 0; }
    thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    tbody tr { padding: 12px 16px; border-top: 1px solid var(--line); }
    tbody tr:first-child { border-top: 0; }
    tbody th, tbody td { display: grid; grid-template-columns: 6.5rem minmax(0, 1fr); gap: 8px; padding: 3px 0; border: 0; }
    tbody th.lead { display: block; padding-bottom: 6px; }
    .k { display: block; padding-top: 2px; font: 600 0.66rem/1.4 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-lo); }
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
  }

  @media (forced-colors: active) {
    .bar, .verdict, .metrics, .metric + .metric, .tile, .gapgroup, .sheet, .exc, .rec, .pill, .chip, .flag, .callout, .empty, .tag { border-color: CanvasText; }
    .tile { border-top-color: CanvasText; }
    .meter, .mark { forced-color-adjust: none; }
    .meter .track { fill: Canvas; }
    .meter rect:not(.track) { fill: CanvasText; }
    .meter .seg-partial, .meter .seg-waived, .meter .seg-not_applicable, .meter .mix-medium, .meter .mix-low { fill: GrayText; }
    .meter .cut { stroke: Canvas; }
    .mark .ring, .mark .inner { stroke: CanvasText; }
    .mark .dot { fill: CanvasText; }
    tbody tr:target, .exc li:target { outline: 2px solid Highlight; outline-offset: -2px; }
  }

  @page {
    margin: 14mm 12mm 16mm;
    @top-left { content: "Secure SDLC Evidence Summary"; font: 8pt sans-serif; }
    @bottom-right { content: "Page " counter(page) " of " counter(pages); font: 8pt sans-serif; }
  }
  @media print {
    html { font-size: 10pt; scroll-behavior: auto; }
    .wrap { max-width: none; padding: 0; }
    .bar { position: static; border-bottom: 1.5pt solid var(--text-hi); }
    .bar nav { display: none; }
    a { color: inherit; text-decoration: none; }
    code, a code { display: inline; padding: 0; line-height: inherit; border: 0; }
    .hero { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 10pt; margin-top: 12pt; }
    .verdict { padding: 16pt; background: none; border-width: 1.5pt; }
    .word { font-size: 34pt; }
    .tiles { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .block { margin-top: 18pt; }
    .callout, .empty { background: none; }
    .hero, .metric, .tile, .gapgroup li, .exc li, .rec > div, .callout, tr, details { break-inside: avoid; }
    .head, .gapgroup h3 { break-after: avoid; }
    thead { display: table-header-group; }
    /* On paper a table is ruled lines, not a framed card: a frame cut by a page break reads as a missing row. */
    .sheet { overflow: visible; border: 0; border-radius: 0; background: none; }
    table { font-size: 8.5pt; border-bottom: 1px solid var(--line-2); }
    thead th { border-bottom: 1px solid var(--line-2); letter-spacing: 0.08em; }
    th, td { padding: 4pt 5pt; }
    .c-main { min-width: 14em; }
    .c-ref { min-width: 12.5em; }
    details { margin-top: 3pt; }
    summary { min-height: 0; }
    details p { margin-top: 1pt; }
    .meter, .meter * { print-color-adjust: exact; -webkit-print-color-adjust: exact; }
    details > summary::before, details[open] > summary::before { content: none; }
    .why .more > summary { display: none; }
    details::details-content { display: block; content-visibility: visible; }
    footer { padding-bottom: 0; }
  }
</style>
</head>
<body>
<svg class="sprite" aria-hidden="true" focusable="false" width="0" height="0">
  <symbol id="i-met" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6.4" stroke-width="1.5"/><path d="M5.1 8.3l2 2 3.8-4.3" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  <symbol id="i-partial" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6.4" stroke-width="1.5"/><path d="M8 1.6a6.4 6.4 0 0 0 0 12.8z" fill="currentColor" stroke="none"/></symbol>
  <symbol id="i-missing" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6.4" stroke-width="1.5"/><path d="M5.6 5.6l4.8 4.8M10.4 5.6l-4.8 4.8" stroke-width="1.6" stroke-linecap="round"/></symbol>
  <symbol id="i-waived" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6.4" stroke-width="1.5"/><path d="M5 8h6" stroke-width="1.6" stroke-linecap="round"/></symbol>
  <symbol id="i-na" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6.4" stroke-width="1.5" stroke-dasharray="2.4 2.2"/></symbol>
  <symbol id="i-dot" viewBox="0 0 16 16"><circle cx="8" cy="8" r="3.2" fill="currentColor" stroke="none"/></symbol>
  <symbol id="i-v-ready" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9.5" stroke-width="1.8"/><path d="M7.6 12.4l3 3 5.8-6.6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  <symbol id="i-v-conditional" viewBox="0 0 24 24"><path d="M12 3.2 22 20.5H2z" stroke-width="1.8" stroke-linejoin="round"/><path d="M12 9.6v5.2" stroke-width="2" stroke-linecap="round"/><circle cx="12" cy="17.6" r="1.1" fill="currentColor" stroke="none"/></symbol>
  <symbol id="i-v-not_ready" viewBox="0 0 24 24"><path d="M8.1 2.6h7.8l5.5 5.5v7.8l-5.5 5.5H8.1l-5.5-5.5V8.1z" stroke-width="1.8" stroke-linejoin="round"/><path d="M8.6 8.6l6.8 6.8M15.4 8.6l-6.8 6.8" stroke-width="2" stroke-linecap="round"/></symbol>
</svg>
<header class="bar">
<div class="wrap bar-in">
  <a class="brand" href="#status"><svg class="mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><circle class="ring" cx="16" cy="16" r="14"/><circle class="inner" cx="16" cy="16" r="7"/><circle class="dot" cx="16" cy="16" r="2.4"/></svg><span><b>{{ bundle.application.name }}</b> {{ bundle.release.release_id }}</span></a>
  {{ pill(verdict, verdict_tone.get(verdict, "muted"), "v-" ~ verdict) }}
  <nav aria-label="Sections">
    <ul>
      <li><a href="#status">Status</a></li>
      {% if errors %}<li><a href="#inputs">Unreadable inputs {{ errors | length }}</a></li>{% endif %}
      {% if ignored_inputs is defined and ignored_inputs %}<li><a href="#unrecognized">Not recognized {{ ignored_inputs | length }}</a></li>{% endif %}
      <li><a href="#map">Controls {{ controls | length }}</a></li>
      <li><a href="#gaps">Gaps {{ bundle.gaps | length }}</a></li>
      <li><a href="#evidence">Evidence {{ bundle.evidence | length }}</a></li>
      <li><a href="#exceptions">Exceptions {{ exception_total }}</a></li>
      <li><a href="#record">Record</a></li>
    </ul>
  </nav>
</div>
</header>

<main class="wrap">
<div class="hero" id="status">
  <section class="verdict status-{{ verdict }}" data-verdict="{{ verdict }}">
    <p class="eyebrow">Release status</p>
    <h1 class="word">{{ icon("v-" ~ verdict) }}{{ verdict_word.get(verdict, verdict) }}</h1>
    <p class="meaning">
      {% if risk_moved %}
      The risk-weighted rule set this verdict. The first reason below says what it found.
      {% else %}
      {{ verdict_meaning.get(verdict, "") }}
      {% endif %}
    </p>
    <div class="cols">
      <div>
        <h2 class="label">Why</h2>
        <ul class="why">
          {% if errors %}
          <li class="caution">{{ icon("v-conditional") }}<span>{{ errors | length }} supplied input(s) failed to parse, so a gap below may not be a real one. <a href="#inputs">See the inputs</a>.</span></li>
          {% endif %}
          {% if risk %}
          <li>Risk-weighted (<code>{{ risk.mode }}</code>): presence-based verdict <code>{{ risk.base_release_status.value }}</code>. {{ risk.rationale }}{% if risk_moved %}<span class="tag">decides the verdict</span>{% endif %}</li>
          {% endif %}
          {% if summary.missing_critical_evidence %}
          {% set by_level = {"critical": [], "high": [], "other": []} %}
          {% for item in summary.missing_critical_evidence %}
            {% set level = control_level.get(item.rsplit(":", 1)[0], "other") %}
            {% set _ = by_level[level if level in by_level else "other"].append(item) %}
          {% endfor %}
          {#- Every critical item stays in view (each one alone blocks the release);
              beyond that, four items, and the rest behind the disclosure. -#}
          {% set chip_cap = [4, by_level.critical | length] | max %}
          {% set missing_total = summary.missing_critical_evidence | length %}
          <li>Critical or high evidence is missing for:
            {{ missing_chips(by_level, 0, chip_cap) }}
            {% if missing_total > chip_cap %}
            <details class="more">
              <summary>{{ missing_total - chip_cap }} more</summary>
              {{ missing_chips(by_level, chip_cap, missing_total) }}
            </details>
            {% endif %}
          </li>
          {% else %}
          <li>No critical or high evidence is missing.</li>
          {% endif %}
          {% if bundle.gaps %}
          {% set parts = [] %}
          {% for level in levels if gap_count[level] %}{% set _ = parts.append(gap_count[level] ~ " " ~ level) %}{% endfor %}
          <li><a href="#gaps">{{ bundle.gaps | length }} gap(s)</a>: {{ parts | join(" · ") }}.</li>
          {% else %}
          <li>No gaps detected.</li>
          {% endif %}
          {% if exceptions_in_force %}
          <li><a href="#exceptions">{{ exceptions_in_force | length }} approved exception(s)</a> applied to this release.</li>
          {% endif %}
          {% if custom_catalog %}
          <li class="caution">{{ icon("v-conditional") }}<span>Evaluated against a custom catalog, not the one shipped with the tool. The same evidence can give another verdict under another catalog.</span></li>
          {% endif %}
        </ul>
      </div>
      <div class="next">
        <h2 class="label">Next step</h2>
        <p>
          {% if errors %}
          Fix the {{ errors | length }} input(s) that failed to parse and run the collector again. Until then a gap may be a parsing failure, not missing evidence.
          {% elif risk_moved %}
          Fix or replace the component behind the vulnerability named in the risk-weighted reason, then collect the scan again and run <code>enrich</code>. The scan record is in the evidence inventory.
          {% elif urgent_gaps %}
          Produce the evidence for the {{ urgent_gaps }} critical and high gap(s). They come first under Gaps, each with what to produce.
          {% elif bundle.gaps %}
          No critical or high gap is open. Review the {{ bundle.gaps | length }} remaining gap(s) under Gaps.
          {% elif verdict != "ready" %}
          Read the rationale of each control that is not met in the control list below.
          {% else %}
          This report asks for no action. Keep <code>bundle.json</code> with the release record; <code>sdlc-evidence verify bundle.json</code> prints its digest.
          {% endif %}
        </p>
      </div>
    </div>
  </section>

  <div class="metrics">
    <div class="metric">
      <div class="label">Evidence coverage</div>
      <p class="num">{{ summary.evidence_coverage_score }}<span class="unit">/100</span></p>
      {{ meter(summary.evidence_coverage_score) }}
      <p class="hint">How much of the expected evidence was found. Required evidence weighs twice as much as recommended evidence.</p>
    </div>
    <div class="metric">
      <div class="label">Evidence strength</div>
      <p class="num">{{ summary.confidence_score }}<span class="unit">/100</span></p>
      {{ parts_bar(strength_mix, "mix") }}
      <p class="hint strength">
        {% if backed %}
        Average confidence of the {{ backed | length }} control(s) that are met, partial or waived: {% for level, count in strength_mix %}{{ count }} {{ level }}{% if not loop.last %} · {% endif %}{% endfor %}.
        High counts 100, medium 66, low 33; a control backed by manually attested evidence counts one level lower. Missing controls are not in this number.
        {% else %}
        No control is met, partial or waived, so there is no confidence to average.
        {% endif %}
      </p>
    </div>
    <div class="metric">
      <div class="label">Controls</div>
      <p class="num">{{ summary.controls_met }}<span class="unit">/{{ summary.total_controls }} met</span></p>
      {{ parts_bar(control_counts, "seg") }}
      <p class="legend" aria-hidden="true">
        {%- for name, count in control_counts %}
        <span data-tone="{{ control_tone[name] }}">{{ icon(control_glyph[name]) }}{{ count }} {{ "n/a" if name == "not_applicable" else name }}</span>
        {%- endfor %}
      </p>
      <div class="meta">{% for name, count in control_counts %}{{ count }} {{ "n/a" if name == "not_applicable" else name }}{% if not loop.last %} · {% endif %}{% else %}no controls{% endfor %}</div>
    </div>
  </div>
</div>

{% if errors %}
<section class="block" id="inputs">
<div class="head"><h2>Inputs that could not be read</h2></div>
<div class="callout">
  {{ icon("v-conditional") }}
  <p>
    <strong>{{ errors | length }} supplied input(s) failed to
    parse.</strong> A control below may read as <em>missing evidence</em> when the
    evidence was in fact provided and could not be ingested. Fix the inputs and
    re-run before treating any gap here as a real one.
  </p>
</div>
<div class="sheet" role="region" aria-label="Inputs that could not be read table" tabindex="0">
<table role="table">
  <thead role="rowgroup">
    <tr role="row">
      <th role="columnheader" scope="col">Input</th>
      <th role="columnheader" scope="col">Why it was not ingested</th>
    </tr>
  </thead>
  <tbody role="rowgroup">
    {% for error in errors %}
    <tr role="row">
      <td role="cell" class="wide"><span class="k" aria-hidden="true">Input</span><div><code>{{ error.path }}</code></div></td>
      <td role="cell" class="wide"><span class="k" aria-hidden="true">Why</span><div>{{ error.reason }}</div></td>
    </tr>
    {% endfor %}
  </tbody>
</table>
</div>
</section>
{% endif %}

{% if ignored_inputs is defined and ignored_inputs %}
<section class="block" id="unrecognized">
<div class="head"><h2>Inputs not recognized</h2></div>
{#- Count only: this page does not show artifact file paths (owner decision,
    2026-11-13). The list is in report.md and in the run's console output. -#}
<p class="lede">{{ ignored_inputs | length }} file(s) in the artifact directories matched no parser and were not collected. They are not errors, but a control may be missing evidence that one of them was meant to carry. The file list is in <code>report.md</code> and in the console output of the run.</p>
</section>
{% endif %}

<section class="block" id="map">
<div class="head"><h2>Controls at a glance</h2><p class="lede">Most critical first. Each tile opens its row below.</p></div>
{% if controls %}
<ul class="tiles">
  {% for evaluation in controls %}
  {% set status = evaluation.evaluation_status.value %}
  <li><a class="tile" data-tone="{{ control_tone.get(status, 'muted') }}" href="#ctl-{{ loop.index }}">
    <span class="tile-top">{{ icon(control_glyph.get(status, "dot")) }}<b>{{ evaluation.control_id }}</b></span>
    <span class="tile-name">{{ evaluation.control_name }}</span>
    <span class="tile-foot"><span>{{ evaluation.criticality.value }}</span><span class="st">{{ status | replace("_", " ") }}</span></span>
  </a></li>
  {% endfor %}
</ul>
{% else %}
<p class="empty">No control was evaluated.</p>
{% endif %}
</section>

<section class="block" id="gaps">
<div class="head"><h2>Gaps</h2>{% if bundle.gaps %}<p class="lede">{{ bundle.gaps | length }} open, grouped by how much each one weighs on the verdict.</p>{% endif %}</div>
{% if bundle.gaps %}
{% for level in levels if gap_count[level] %}
<div class="gapgroup g-{{ level }}">
  <h3>{{ level | capitalize }}<small>{{ gap_count[level] }} · {{ gap_note[level] }}</small></h3>
  <ul>
    {% for gap in bundle.gaps if gap.criticality.value == level %}
    <li>
      <span>{{ control_link(gap.control_id) }}</span>
      <span class="etype">{{ gap.evidence_type.value if gap.evidence_type else "-" }}</span>
      {#- The hint names the records that are present and did not satisfy the
          control, so it carries what the description says, as an action. -#}
      <div>
        <p>{{ ticked(gap.remediation or gap.description) }}</p>
        {% if control_status.get(gap.control_id) == "waived" %}<span class="sub">The control is waived, so this gap does not count against the verdict.</span>{% endif %}
      </div>
    </li>
    {% endfor %}
  </ul>
</div>
{% endfor %}
{% else %}
<p class="empty" data-tone="ok">{{ icon("met") }}Nothing is missing for this release. No gaps detected.</p>
{% endif %}
</section>

<section class="block" id="controls">
<div class="head"><h2>Controls</h2><p class="lede">{{ controls | length }} control(s){% if bundle.catalog %} from <code>{{ bundle.catalog.name }}</code>{% endif %}.</p></div>
<div class="sheet" role="region" aria-label="Controls table" tabindex="0">
<table role="table">
  <thead role="rowgroup">
    <tr role="row">
      <th role="columnheader" scope="col">Control</th>
      <th role="columnheader" scope="col">Framework</th>
      <th role="columnheader" scope="col">Criticality</th>
      <th role="columnheader" scope="col">Status</th>
      <th role="columnheader" scope="col">Confidence</th>
      <th role="columnheader" scope="col">Evidence</th>
    </tr>
  </thead>
  <tbody role="rowgroup">
    {% for evaluation in controls %}
    {% set status = evaluation.evaluation_status.value %}
    <tr role="row" id="ctl-{{ loop.index }}">
      <th role="rowheader" scope="row" class="lead c-main wide">
        <code>{{ evaluation.control_id }}</code>
        <span class="sub">{{ evaluation.control_name }}</span>
        <details{% if status != "met" %} open{% endif %}>
          <summary>Rationale</summary>
          <p>{{ evaluation.rationale }}</p>
        </details>
      </th>
      <td role="cell"><span class="k" aria-hidden="true">Framework</span><div>{{ evaluation.framework.value | replace("_", " ") }}</div></td>
      <td role="cell"><span class="k" aria-hidden="true">Criticality</span><div><span class="crit" data-level="{{ evaluation.criticality.value }}">{{ evaluation.criticality.value }}</span></div></td>
      <td role="cell"><span class="k" aria-hidden="true">Status</span><div>{{ pill(status | replace("_", " "), control_tone.get(status, "muted"), control_glyph.get(status, "dot")) }}</div></td>
      <td role="cell"><span class="k" aria-hidden="true">Confidence</span><div>{{ evaluation.confidence.value }}</div></td>
      <td role="cell" class="c-ref wide"><span class="k" aria-hidden="true">Evidence</span><div class="refs">
        {%- if evaluation.evidence_refs -%}
          {%- for ref in evaluation.evidence_refs -%}
          {%- if ref in evidence_row %}<a class="ref" href="#ev-{{ evidence_row[ref] }}"><code>{{ ref }}</code></a>{% else %}<code>{{ ref }}</code>{% endif -%}
          {%- endfor -%}
        {%- else %}none{% endif -%}
        {%- for ref in evaluation.exception_refs if status == "waived" %}
        <span class="waiver">waived by {% if ref in exception_row %}<a class="ref" href="#exc-{{ exception_row[ref] }}"><code>{{ ref }}</code></a>{% else %}<code>{{ ref }}</code>{% endif %}</span>
        {%- endfor %}
      </div></td>
    </tr>
    {% endfor %}
  </tbody>
</table>
</div>
</section>

<section class="block" id="evidence">
<div class="head"><h2>Evidence inventory</h2><p class="lede">{{ bundle.evidence | length }} record(s) collected for this release.</p></div>
<div class="sheet" role="region" aria-label="Evidence inventory table" tabindex="0">
<table role="table">
  <thead role="rowgroup">
    <tr role="row">
      <th role="columnheader" scope="col">Evidence</th>
      <th role="columnheader" scope="col">Produced by</th>
      <th role="columnheader" scope="col">Status</th>
      <th role="columnheader" scope="col">Confidence</th>
      <th role="columnheader" scope="col">Findings</th>
    </tr>
  </thead>
  <tbody role="rowgroup">
    {% for item in bundle.evidence %}
    {% set tone = evidence_tone.get(item.status.value, "muted") %}
    <tr role="row" id="ev-{{ loop.index }}">
      <th role="rowheader" scope="row" class="lead c-ref wide">
        <code>{{ item.evidence_type.value }}</code>
        <span class="sub mono">{{ item.evidence_id }}</span>
        {% if item.evidence_id in supports %}
        <span class="supports">supports {% for control_id in supports[item.evidence_id] %}{{ control_link(control_id) }}{% if not loop.last %} {% endif %}{% endfor %}</span>
        {% endif %}
      </th>
      {#- A manually attested item names the tool the operator says produced it,
          so the producer alone reads as though the tool was collected from. -#}
      <td role="cell" class="free"><span class="k" aria-hidden="true">Produced by</span><div>{{ item.producer }}<span class="sub">{{ item.source.kind }}{% if item.manual %} · manual attestation{% endif %}</span></div></td>
      <td role="cell"><span class="k" aria-hidden="true">Status</span><div>{{ pill(item.status.value, tone, tone_glyph.get(tone, "dot")) }}</div></td>
      <td role="cell"><span class="k" aria-hidden="true">Confidence</span><div>{{ item.confidence.value }}</div></td>
      <td role="cell" class="free"><span class="k" aria-hidden="true">Findings</span><div>{% for key, value in item.findings_count.items() if value %}{{ value }} {{ key }}{% if not loop.last %} · {% endif %}{% else %}none{% endfor %}</div></td>
    </tr>
    {% endfor %}
  </tbody>
</table>
</div>
</section>

<div id="exceptions">
{% if exceptions_in_force %}
<section class="block" id="approved">
<div class="head"><h2>Approved exceptions</h2><p class="lede">Waivers this release relied on.</p></div>
<ul class="exc">
  {% for exception in exceptions_in_force %}
  <li id="exc-{{ loop.index }}"><code>{{ exception.exception_id }}</code> for {{ control_link(exception.control_id) }}
    <span class="sub free">approved by {{ exception.approver }} · expires {{ exception.expires_at.isoformat() }}{% if exception.reference %} · reference {{ exception.reference }}{% endif %}</span></li>
  {% endfor %}
</ul>
</section>
{% endif %}
{% if exceptions_not_in_force %}
<section class="block" id="not-in-force">
<div class="head"><h2>Exceptions not in force</h2><p class="lede">Supplied with the evidence but not applied to this release.</p></div>
<ul class="exc">
  {% for exception, reason in exceptions_not_in_force %}
  <li><code>{{ exception.exception_id }}</code> for {{ control_link(exception.control_id) }}
    <span class="sub free">approved by {{ exception.approver }} · expires {{ exception.expires_at.isoformat() }} · {{ reason }}</span></li>
  {% endfor %}
</ul>
</section>
{% endif %}
{% if not exception_total %}
<section class="block">
<div class="head"><h2>Exceptions</h2></div>
<p class="empty">No exception was supplied.</p>
</section>
{% endif %}
</div>

<section class="block" id="record">
<div class="head"><h2>Record</h2><p class="lede">What this verdict is anchored to.</p></div>
<dl class="rec">
  <div><dt>application</dt><dd>{{ bundle.application.name }}<span class="sub mono">{{ bundle.application.repository }} · {{ bundle.application.environment }}</span></dd></div>
  <div><dt>release</dt><dd>{{ bundle.release.release_id }}<span class="sub mono">commit {{ bundle.release.commit_sha }}{% if bundle.release.branch %} · branch {{ bundle.release.branch }}{% endif %}</span></dd></div>
  {#- Which catalog produced the verdict: the same evidence yields a different
      release status against a different control set. -#}
  {% if bundle.catalog %}
  <div><dt>control catalog</dt><dd>{{ bundle.catalog.name }}<span class="sub">{% if custom_catalog %}<strong class="flag">{{ icon("v-conditional") }}custom</strong> not the catalog shipped with the tool{% else %}shipped with the tool{% endif %} · {{ bundle.catalog.control_count }} controls · <span class="mono">{{ bundle.catalog.sha256[:12] }}</span></span></dd></div>
  {% endif %}
  <div><dt>bundle</dt><dd class="mono">{{ bundle.bundle_id }}<span class="sub">generated <time datetime="{{ bundle.generated_at.isoformat() }}">{{ bundle.generated_at.isoformat() }}</time></span></dd></div>
  {% for label, value, _ in provenance if value %}
  <div><dt>{{ label }}</dt><dd class="mono">{{ value }}</dd></div>
  {% endfor %}
</dl>
{#- What ties this verdict to one build. An absent value is said, not hidden:
    a verdict with no artifact digest is not bound to an artifact. -#}
{% if unrecorded %}
<p class="lack">Not recorded for this run: {{ unrecorded | map(attribute=0) | join(", ") }}. Without them the verdict is not bound to one build; <code>run</code> takes them as {% for _, _, flag in unrecorded %}<code>{{ flag }}</code>{% if not loop.last %}, {% endif %}{% endfor %}.</p>
{% endif %}
</section>
</main>

<footer class="wrap">
  <p>Produced by Secure SDLC Evidence Collector{% if collector_version is defined and collector_version %} {{ collector_version }}{% endif %} · bundle schema {{ bundle.bundle_version }}</p>
  <p>This page is a rendering of <code>bundle.json</code>, which is the record.{% if not (bundle_digest is defined and bundle_digest) %} <code>sdlc-evidence verify bundle.json</code> prints its digest.{% endif %}</p>
  {% if bundle_digest is defined and bundle_digest %}
  <dl class="kv">
    <dt>bundle digest</dt><dd><code>{{ bundle_digest }}</code></dd>
    <dt>check it with</dt><dd><code>sdlc-evidence verify bundle.json --expected {{ bundle_digest }}</code></dd>
  </dl>
  {% endif %}
</footer>
</body>
</html>
