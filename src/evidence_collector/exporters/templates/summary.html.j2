  .verdict[data-verdict="not_ready"] { --v-ink: var(--bad-ink); --v-strong: var(--bad-strong); --v-fill: var(--bad-fill); --v-glow: var(--bad-glow); --v-tint: var(--bad-tint); --v-line: var(--bad-line); }
