  .why .more { margin-top: 8px; }
  .chip { display: inline-block; min-height: 24px; margin: 4px 4px 0 0; }
  .ref { display: inline-block; min-height: 24px; }
  .tag {
    display: inline-block;
    margin-left: 6px;
    padding: 1px 8px;
    font: 500 0.7rem/1.5 var(--mono);
    color: var(--v-ink);
    border: 1px solid var(--v-line);
    border-radius: 999px;
