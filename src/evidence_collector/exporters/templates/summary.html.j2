{#-
  Release evidence summary: one self-contained file, no script, no request.
  Contracts this template keeps (tests/unit/test_exporters.py and the
  integration tests read the page as text):
  - every section heading is a bare <h2>, with no attribute, so a section can
    be sliced from one heading to the next;
  - "Approved exceptions" and "Exceptions not in force" appear only when
    their section does, navigation entries included;
  - the Controls score is `<div class="label">Controls</div>` followed by a
    `<div class="meta">` that holds the breakdown as plain text;
  - `status-<verdict>` is written once, on the verdict panel. The styles
    select on `data-verdict`, so the other two class names are absent and the
    assertion on the verdict class is a real one;
  - "manual attestation" is written only for a manual evidence record.
  Every bundle string goes through autoescape as a text node. Nothing here is
  marked safe, no bundle string reaches an attribute that is not a text
  attribute, and row anchors are loop positions, never identifiers.
  Optional context, each rendered only when `bundle_to_html` passes it:
  `collector_version`, `bundle_digest` and `ignored_inputs` (its length only).
  Provenance shown: tag, full commit, artifact digest, pipeline run and build
  ids. Not shown: artifact file paths, per-evidence hashes, owner_team,
  waiver justification and approved_at (owner decision, 2026-11-13).
-#}
{% set summary = bundle.summary %}
{% set verdict = summary.release_status.value %}
{% set risk = summary.risk_assessment %}
{% set errors = bundle.collection_errors or [] %}
{% set exceptions_in_force, exceptions_not_in_force = split_exceptions(bundle) %}
{% set levels = ["critical", "high", "medium", "low"] %}
{#- The release-anchor drift check can degrade the verdict after the risk mode
    ran, so the final verdict alone does not say the risk mode moved it. -#}
{% set risk_moved = (risk_weighted_status(risk) != risk.base_release_status) if risk else false %}
{% set custom_catalog = (bundle.catalog.origin == "custom") if bundle.catalog else false %}
{#- Row positions for the cross-links, and the controls each record supports. -#}
{% set control_row = {} %}
{% set control_level = {} %}
{% set evidence_row = {} %}
{% set exception_row = {} %}
{% set supports = {} %}
{% for evaluation in bundle.control_evaluations %}
  {% set _ = control_row.setdefault(evaluation.control_id, loop.index) %}
  {% set _ = control_level.setdefault(evaluation.control_id, evaluation.criticality.value) %}
  {% for ref in evaluation.evidence_refs %}
    {% set _ = supports.setdefault(ref, []).append(evaluation.control_id) %}
  {% endfor %}
{% endfor %}
{% for item in bundle.evidence %}
  {% set _ = evidence_row.setdefault(item.evidence_id, loop.index) %}
{% endfor %}
{% for exception in exceptions_in_force %}
  {% set _ = exception_row.setdefault(exception.exception_id, loop.index) %}
{% endfor %}
{% set gap_count = {} %}
{% for level in levels %}
  {% set _ = gap_count.update({level: bundle.gaps | selectattr("criticality", "equalto", level) | list | length}) %}
{% endfor %}
{% set urgent_gaps = gap_count.critical + gap_count.high %}
{% set verdict_word = {"ready": "Ready", "conditional": "Conditional", "not_ready": "Not ready"} %}
{% set verdict_meaning = {
  "ready": "Every control is met, waived or not applicable.",
  "conditional": "No critical control lacks required evidence, but at least one control is partial or missing, or supplied evidence was set aside.",
  "not_ready": "A critical control lacks required evidence.",
} %}
{% set control_glyph = {"met": "met", "partial": "partial", "missing": "missing", "waived": "waived", "not_applicable": "na"} %}
{% set evidence_tone = {"passed": "ok", "completed": "ok", "failed": "bad", "invalid": "bad", "missing": "bad"} %}
{% set tone_glyph = {"ok": "met", "bad": "missing", "muted": "dot"} %}
{% set level_glyph = {"critical": "c4", "high": "c3", "medium": "c2", "low": "c1"} %}
{% macro icon(name) -%}
<svg class="i" aria-hidden="true" focusable="false"><use href="#i-{{ name }}"/></svg>
{%- endmacro %}
{#- Engine text marks identifiers with backticks. Balanced pairs become <code>;
    anything else is written as it came. Each part is escaped on its own. -#}
{% macro ticked(text) -%}
{%- set parts = (text or "").split("`") -%}
{%- if parts | length is odd -%}
{%- for part in parts -%}
{%- if loop.index0 is odd -%}<code>{{ part }}</code>{%- else -%}{{ part }}{%- endif -%}
{%- endfor -%}
{%- else -%}{{ text }}{%- endif -%}
{%- endmacro %}
{% macro control_link(control_id) -%}
{%- if control_id in control_row -%}
<a class="ref" href="#ctl-{{ control_row[control_id] }}"><code>{{ control_id }}</code></a>
{%- else -%}<code>{{ control_id }}</code>{%- endif -%}
{%- endmacro %}
{% macro level_mark(level) -%}
<span class="level">{{ icon(level_glyph.get(level, "c1")) }}{{ level }}</span>
{%- endmacro %}
{% macro meter(value, kind) -%}
<svg class="meter meter-{{ kind }}" viewBox="0 0 100 4" preserveAspectRatio="none" aria-hidden="true" focusable="false"><rect class="track" width="100" height="4"/><rect class="fill" width="{{ value | int }}" height="4"/></svg>
{%- endmacro %}
{#- The missing items in flat positions [first, last), critical first, each
    group under its own label. Called twice: the first few in the verdict
    panel, the rest inside a disclosure, so a long list does not push the
    next step below the first screen of a phone. -#}
{% macro missing_chips(by_level, first, last) -%}
{%- set position = namespace(offset=0) -%}
{%- for label, key in [("critical, blocks the release", "critical"), ("high", "high"), ("not in the control list", "other")] -%}
{%- set items = by_level[key] -%}
{%- set shown = items[[first - position.offset, 0] | max : [last - position.offset, 0] | max] -%}
{%- if shown %}
<span class="sub">{{ label }}</span>
{% for item in shown %}
{% set control_id = item.rsplit(":", 1)[0] %}
{% if control_id in control_row %}<a class="chip" href="#ctl-{{ control_row[control_id] }}"><code>{{ item }}</code></a>{% else %}<span class="chip"><code>{{ item }}</code></span>{% endif %}
{% endfor %}
{%- endif -%}
{%- set position.offset = position.offset + items | length -%}
{%- endfor -%}
{%- endmacro %}
