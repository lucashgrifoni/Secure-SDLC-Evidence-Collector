  .brand { display: inline-flex; align-items: center; gap: 9px; min-width: 0; min-height: 32px; font-size: 0.875rem; color: var(--text-hi); text-decoration: none; overflow-wrap: anywhere; }
  .brand b { font-weight: 700; }
