  .next { margin-top: auto; padding-top: 4px; }
  .next p { padding: 12px 14px; font-size: 0.95rem; color: var(--text-hi); background: var(--code-bg); border: 1px solid var(--line); border-radius: var(--r-2); }

  .scores { display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: var(--r-4); background: var(--sheet); }
  .score { flex: 1; padding: 20px 24px; }
  .score + .score { border-top: 1px solid var(--line); }
  .value { margin-top: 6px; font-size: 1.7rem; font-weight: 500; line-height: 1.15; letter-spacing: -0.02em; color: var(--text-hi); }
  .unit { font: 400 0.9rem var(--mono); letter-spacing: 0; color: var(--text-lo); }
  .meta { font-size: 0.86rem; color: var(--text-lo); }
  .hint { margin-top: 8px; font-size: 0.8rem; line-height: 1.45; color: var(--text-lo); }
  .meter, .bar { display: block; width: 100%; height: 6px; margin-top: 10px; border-radius: 999px; overflow: hidden; }
  .bar { height: 8px; }
  .track { fill: var(--track); }
  .meter-main .fill { fill: var(--meter-a); }
  .meter-alt .fill { fill: var(--meter-alt-a); }
  .seg-met { fill: var(--ok-fill); }
  .seg-partial { fill: var(--warn-fill); }
  .seg-missing { fill: var(--bad-fill); }
  .seg-waived, .seg-not_applicable { fill: var(--muted-fill); }

  /* Facts strip */
  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); margin-top: 16px; border: 1px solid var(--line); border-radius: var(--r-3); background: var(--sheet); }
  .fact { min-width: 0; padding: 18px 22px; box-shadow: -1px 0 0 var(--line), 0 -1px 0 var(--line); }
  .fact .fv { margin-top: 6px; font-size: 1.15rem; font-weight: 500; letter-spacing: -0.015em; color: var(--text-hi); overflow-wrap: anywhere; }
  .facts { overflow: hidden; }
  .provenance { grid-column: 1 / -1; }
  .pairs { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 10px 24px; margin-top: 8px; font-size: 0.86rem; color: var(--text-lo); }
  .pairs > div { min-width: 0; }
  .pairs dt, .kv dt { font-family: var(--mono); font-size: 0.74rem; }
  .pairs dd { margin-top: 2px; }
  .kv { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 3px 12px; margin-top: 8px; }
  .absent { font-style: italic; }
  .flag { display: inline-flex; align-items: center; gap: 5px; padding: 0 8px; font: 500 0.74rem/1.6 var(--mono); color: var(--warn-ink); background: var(--warn-tint); border: 1px solid var(--warn-line); border-radius: 999px; }

  /* Page navigation */
  .toc { margin-top: 24px; }
  .toc ul { display: flex; flex-wrap: wrap; gap: 8px; }
  .toc a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 32px;
    padding: 4px 14px;
    font-size: 0.86rem;
    color: var(--text-hi);
    text-decoration: none;
    border: 1px solid var(--line-2);
    border-radius: 999px;
  }
  .toc a:hover { border-color: var(--accent-line); }
  .toc .n { font: 500 0.74rem var(--mono); color: var(--text-lo); }

  /* Sections */
  .block { margin-top: 40px; }
  .block > h2 { display: flex; align-items: center; gap: 12px; font-size: 1.3rem; font-weight: 500; line-height: 1.2; letter-spacing: -0.02em; color: var(--text-hi); }
  .block > h2::before { content: ""; flex: none; width: 28px; border-top: 1px solid var(--accent); }
  .lede { margin-top: 8px; max-width: 86ch; font-size: 0.93rem; color: var(--text-lo); }
  .lede strong { color: var(--text-hi); font-weight: 600; }
  .callout { display: flex; gap: 12px; margin-top: 12px; padding: 14px 16px; color: var(--text-hi); background: var(--warn-tint); border: 1px solid var(--warn-line); border-radius: var(--r-3); }
  .callout .i { width: 1.2em; height: 1.2em; margin-top: 0.15em; color: var(--warn-ink); }
  .callout p { max-width: 80ch; font-size: 0.93rem; }
  .empty { margin-top: 12px; padding: 14px 16px; font-size: 0.93rem; color: var(--text-lo); border: 1px dashed var(--line-2); border-radius: var(--r-3); }

  /* A sheet scrolls sideways instead of cutting a column off: if a table is
     ever wider than its sheet, every column stays reachable (keyboard
     included, through tabindex on the region). The card layout below keeps
     the known content from needing it. */
  .sheet { margin-top: 14px; border: 1px solid var(--line); border-radius: var(--r-3); background: var(--sheet); overflow-x: auto; }
  .sheet:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  th, td { padding: 10px 14px; text-align: left; vertical-align: top; font-weight: 400; border-top: 1px solid var(--line); overflow-wrap: break-word; }
  /* Cells that carry free text from the bundle wrap `anywhere`: unlike
     `break-word`, it lowers the cell's minimum width, so one long unbroken
     value cannot widen the whole table. Short enumerated values (framework,
     status, dates) keep `break-word` and never split inside a word. */
  td.wide, th.wide, .free { overflow-wrap: anywhere; }
  thead th { font: 500 0.7rem/1.4 var(--mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-lo); background: var(--sheet-head); border-top: 0; white-space: nowrap; }
  tbody tr:target { background: var(--target); }
  tr { scroll-margin-top: 16px; }
  .k { display: none; }
  .c-main { min-width: 15rem; }
  .c-ref { min-width: 11.5rem; }
  /* An approver is usually an e-mail address: room for one on a line, so a long
     reference in the same row cannot squeeze it into broken fragments. */
  .c-who { min-width: 13rem; }
  .c-id { min-width: 10rem; }
  .name { display: block; margin-top: 3px; font-size: 0.86rem; color: var(--text-lo); }
  .group th { padding: 9px 14px; font: 500 0.74rem var(--mono); color: var(--text-hi); background: var(--sheet-head); }
  .group .n { margin-left: 8px; color: var(--text-lo); }
  .level { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; }
  .level .i { fill: currentColor; stroke: none; }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px 10px 2px 8px;
    font: 500 0.76rem/1.5 var(--mono);
    letter-spacing: 0.02em;
    white-space: nowrap;
    color: var(--p-ink);
    background: var(--p-tint);
    border: 1px solid var(--p-line);
    border-radius: 999px;
  }
  .pill-met, .pill[data-tone="ok"] { --p-ink: var(--ok-ink); --p-tint: var(--ok-tint); --p-line: var(--ok-line); }
  .pill-partial { --p-ink: var(--warn-ink); --p-tint: var(--warn-tint); --p-line: var(--warn-line); }
  .pill-missing, .pill[data-tone="bad"] { --p-ink: var(--bad-ink); --p-tint: var(--bad-tint); --p-line: var(--bad-line); }
  .pill-waived, .pill-not_applicable, .pill[data-tone="muted"] { --p-ink: var(--muted-ink); --p-tint: var(--muted-tint); --p-line: var(--muted-line); }
  .pill-waived, .pill-not_applicable { border-style: dashed; }
  .manual { font-size: 0.85rem; color: var(--text-lo); }
  .supports { display: block; margin-top: 4px; font-size: 0.8rem; color: var(--text-lo); }
  .refs .ref, .refs > code { display: inline-block; margin: 0 4px 4px 0; }
  .waiver { display: block; font-size: 0.8rem; color: var(--text-lo); }

  details { margin-top: 6px; }
  summary { display: inline-flex; align-items: center; gap: 8px; min-height: 24px; font: 500 0.72rem var(--mono); color: var(--text-lo); cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary::before { content: "+"; display: grid; place-items: center; width: 16px; height: 16px; font-size: 0.8rem; line-height: 1; color: var(--accent-ink); border: 1px solid var(--accent-line); border-radius: var(--r-1); }
  details[open] > summary::before { content: "\2212"; }
  details p { margin-top: 4px; max-width: 70ch; font-size: 0.86rem; color: var(--text-lo); }

  footer { margin-top: 48px; padding-top: 20px; font-size: 0.8rem; color: var(--text-lo); border-top: 1px solid var(--line); }
  footer p + p, footer .kv { margin-top: 6px; }

  @media (max-width: 880px) {
    .overview { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 560px) {
    .wrap { padding: 24px 16px 40px; }
    .verdict { padding: 26px 20px 20px; }
    .verdict::before { left: 20px; }
    .score, .fact { padding: 16px 18px; }
    .stamp { flex-direction: column; }
  }

  /* Below the width at which the widest known table (Controls of a real
     not_ready bundle) fits its sheet, a row becomes a card, so nothing
     scrolls sideways on a tablet or a zoomed desktop either. The roles
     written on the table elements keep them a table for assistive
     technology after `display` changes. */
  @media screen and (max-width: 1000px) {
    table, tbody, tr, th, td { display: block; }
    .c-main, .c-ref, .c-who, .c-id { min-width: 0; }
    thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    tbody tr { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 10px 16px; padding: 14px 16px; border-top: 1px solid var(--line); }
    tbody tr:first-child { border-top: 0; }
    tbody + tbody tr:first-child { border-top: 1px solid var(--line); }
    tbody td, tbody th { min-width: 0; padding: 0; border: 0; }
    .wide { grid-column: 1 / -1; }
    .k { display: block; margin-bottom: 3px; font: 500 0.68rem/1.4 var(--mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-lo); }
    .group { background: var(--sheet-head); }
    .group th { padding: 0; background: none; }
  }

  @media (forced-colors: active) {
    .verdict, .scores, .facts, .sheet, .pill, .literal code, .flag, .callout, .next p, .toc a { border-color: CanvasText; }
    .verdict::before, .verdict h2::before, .label::before, dt.name::before, .block > h2::before, .why li::before { border-color: CanvasText; }
    .meter, .bar, .mark { forced-color-adjust: none; }
    .meter .track { fill: Canvas; stroke: CanvasText; stroke-width: 0.5; }
    .meter .fill, .bar rect { fill: CanvasText; }
    .bar .seg-partial, .bar .seg-waived, .bar .seg-not_applicable { fill: GrayText; }
    .mark .ring, .mark .inner { stroke: CanvasText; }
    .mark .dot { fill: CanvasText; }
    tbody tr:target { outline: 2px solid Highlight; outline-offset: -2px; }
  }

  @page {
    margin: 14mm 12mm 16mm;
    @top-left { content: "Secure SDLC Evidence Summary"; font: 8pt sans-serif; }
    @bottom-right { content: "Page " counter(page) " of " counter(pages); font: 8pt sans-serif; }
  }
  @media print {
    html { font-size: 10pt; }
    body { background: none; }
    .wrap { max-width: none; padding: 0; }
    .toc { display: none; }
    a { color: inherit; text-decoration: none; }
    code, a code { display: inline; padding: 0; line-height: inherit; border: 0; }
    .overview { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 10pt; margin-top: 14pt; }
    .verdict { padding: 16pt 16pt 14pt; background: none; border-width: 1.5pt; border-color: var(--v-fill); }
    .verdict::before { left: 16pt; }
    .score { padding: 10pt 14pt; }
    .fact { padding: 10pt 14pt; }
    .facts { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .pairs { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .block { margin-top: 20pt; }
    .next p, .callout, .empty { background: none; }
    .verdict, .scores, .facts, .callout, .next, tr, details { break-inside: avoid; }
    .block > h2, .lede, .group { break-after: avoid; }
    thead { display: table-header-group; }
    /* On paper a table is ruled lines, not a framed card: a frame cut by a page break reads as a missing row. */
    .sheet { overflow: visible; border: 0; border-radius: 0; background: none; }
    table { font-size: 8.5pt; border-bottom: 1px solid var(--line-2); }
    thead th { border-bottom: 1px solid var(--line-2); }
    th, td { padding: 4pt 5pt; }
    thead th { letter-spacing: 0.08em; }
    .c-main { min-width: 14em; }
    .c-ref { min-width: 12.5em; }
    details { margin-top: 3pt; }
    summary { min-height: 0; }
    details p { margin-top: 1pt; }
    .meter, .bar, .track, .fill, [class^="seg-"] { print-color-adjust: exact; -webkit-print-color-adjust: exact; }
    details > summary::before, details[open] > summary::before { content: none; }
    .why .more > summary { display: none; }
    details::details-content { display: block; content-visibility: visible; }
  }
</style>
</head>
<body>
<svg class="sprite" aria-hidden="true" focusable="false" width="0" height="0">
  <symbol id="i-met" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6.4" stroke-width="1.5"/><path d="M5.1 8.3l2 2 3.8-4.3" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  <symbol id="i-partial" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6.4" stroke-width="1.5"/><path d="M8 1.6a6.4 6.4 0 0 0 0 12.8z" fill="currentColor" stroke="none"/></symbol>
  <symbol id="i-missing" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6.4" stroke-width="1.5"/><path d="M5.6 5.6l4.8 4.8M10.4 5.6l-4.8 4.8" stroke-width="1.6" stroke-linecap="round"/></symbol>
  <symbol id="i-waived" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6.4" stroke-width="1.5"/><path d="M5 8h6" stroke-width="1.6" stroke-linecap="round"/></symbol>
  <symbol id="i-na" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6.4" stroke-width="1.5" stroke-dasharray="2.4 2.2"/></symbol>
  <symbol id="i-dot" viewBox="0 0 16 16"><circle cx="8" cy="8" r="3.2" fill="currentColor" stroke="none"/></symbol>
  <symbol id="i-c1" viewBox="0 0 16 16"><rect x="1" y="10" width="2.6" height="5" rx=".6"/><rect x="5" y="7" width="2.6" height="8" rx=".6" opacity=".28"/><rect x="9" y="4" width="2.6" height="11" rx=".6" opacity=".28"/><rect x="13" y="1" width="2.6" height="14" rx=".6" opacity=".28"/></symbol>
  <symbol id="i-c2" viewBox="0 0 16 16"><rect x="1" y="10" width="2.6" height="5" rx=".6"/><rect x="5" y="7" width="2.6" height="8" rx=".6"/><rect x="9" y="4" width="2.6" height="11" rx=".6" opacity=".28"/><rect x="13" y="1" width="2.6" height="14" rx=".6" opacity=".28"/></symbol>
  <symbol id="i-c3" viewBox="0 0 16 16"><rect x="1" y="10" width="2.6" height="5" rx=".6"/><rect x="5" y="7" width="2.6" height="8" rx=".6"/><rect x="9" y="4" width="2.6" height="11" rx=".6"/><rect x="13" y="1" width="2.6" height="14" rx=".6" opacity=".28"/></symbol>
  <symbol id="i-c4" viewBox="0 0 16 16"><rect x="1" y="10" width="2.6" height="5" rx=".6"/><rect x="5" y="7" width="2.6" height="8" rx=".6"/><rect x="9" y="4" width="2.6" height="11" rx=".6"/><rect x="13" y="1" width="2.6" height="14" rx=".6"/></symbol>
  <symbol id="i-v-ready" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9.5" stroke-width="1.8"/><path d="M7.6 12.4l3 3 5.8-6.6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  <symbol id="i-v-conditional" viewBox="0 0 24 24"><path d="M12 3.2 22 20.5H2z" stroke-width="1.8" stroke-linejoin="round"/><path d="M12 9.6v5.2" stroke-width="2" stroke-linecap="round"/><circle cx="12" cy="17.6" r="1.1" fill="currentColor" stroke="none"/></symbol>
  <symbol id="i-v-not_ready" viewBox="0 0 24 24"><path d="M8.1 2.6h7.8l5.5 5.5v7.8l-5.5 5.5H8.1l-5.5-5.5V8.1z" stroke-width="1.8" stroke-linejoin="round"/><path d="M8.6 8.6l6.8 6.8M15.4 8.6l-6.8 6.8" stroke-width="2" stroke-linecap="round"/></symbol>
</svg>
<div class="wrap">
<header>
  <h1><svg class="mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><circle class="ring" cx="16" cy="16" r="14"/><circle class="inner" cx="16" cy="16" r="7"/><circle class="dot" cx="16" cy="16" r="2.4"/></svg>Secure SDLC Evidence Summary</h1>
  <p class="subject"><span class="app">{{ bundle.application.name }}</span><span class="rel">{{ bundle.release.release_id }}</span></p>
  <p class="stamp"><span><code>{{ bundle.bundle_id }}</code></span><span>generated <time datetime="{{ bundle.generated_at.isoformat() }}">{{ bundle.generated_at.isoformat() }}</time></span></p>
</header>

<main>
<div class="overview">
  <section class="verdict status-{{ verdict }}" data-verdict="{{ verdict }}">
    <h2>Release status</h2>
    <p class="word">{{ icon("v-" ~ verdict) }}{{ verdict_word.get(verdict, verdict) }}</p>
    <p class="literal"><code>{{ verdict }}</code><span>release_status in bundle.json</span></p>
    <p class="meaning">
      {% if risk_moved %}
      The risk-weighted rule set this verdict. The first reason below says what it found.
      {% else %}
      {{ verdict_meaning.get(verdict, "") }}
      {% endif %}
    </p>

    <h3>Why</h3>
    <ul class="why">
      {% if errors %}
      <li class="caution">{{ icon("v-conditional") }}<span>{{ errors | length }} supplied input(s) failed to parse, so a gap below may not be a real one. <a href="#inputs">See the inputs</a>.</span></li>
      {% endif %}
      {% if risk %}
      <li>Risk-weighted (<code>{{ risk.mode }}</code>): presence-based verdict <code>{{ risk.base_release_status.value }}</code>. {{ risk.rationale }}{% if risk_moved %}<span class="tag">decides the verdict</span>{% endif %}</li>
      {% endif %}
      {% if summary.missing_critical_evidence %}
      {% set by_level = {"critical": [], "high": [], "other": []} %}
      {% for item in summary.missing_critical_evidence %}
        {% set level = control_level.get(item.rsplit(":", 1)[0], "other") %}
        {% set _ = by_level[level if level in by_level else "other"].append(item) %}
      {% endfor %}
      {#- Every critical item stays in view (each one alone blocks the release);
          beyond that, four items, and the rest behind the disclosure. -#}
      {% set chip_cap = [4, by_level.critical | length] | max %}
      {% set missing_total = summary.missing_critical_evidence | length %}
      <li>Missing critical/high evidence:
        {{ missing_chips(by_level, 0, chip_cap) }}
        {% if missing_total > chip_cap %}
        <details class="more">
          <summary>{{ missing_total - chip_cap }} more</summary>
          {{ missing_chips(by_level, chip_cap, missing_total) }}
        </details>
        {% endif %}
      </li>
      {% else %}
      <li>No critical or high evidence is missing.</li>
      {% endif %}
      {% if bundle.gaps %}
      <li><a href="#gaps">{{ bundle.gaps | length }} gap(s)</a>: {{ gap_count.critical }} critical · {{ gap_count.high }} high · {{ gap_count.medium }} medium · {{ gap_count.low }} low.</li>
      {% else %}
      <li>No gaps detected.</li>
      {% endif %}
      {% if exceptions_in_force %}
      <li><a href="#approved">{{ exceptions_in_force | length }} approved exception(s)</a> applied to this release.</li>
      {% endif %}
      {% if custom_catalog %}
      <li class="caution">{{ icon("v-conditional") }}<span>Evaluated against a custom catalog, not the one shipped with the tool. The same evidence can give another verdict under another catalog.</span></li>
      {% endif %}
    </ul>

    <div class="next">
      <h3>Next step</h3>
      <p>
        {% if errors %}
        Fix the {{ errors | length }} input(s) that failed to parse and run the collector again. Until then a gap may be a parsing failure, not missing evidence.
        {% elif risk_moved %}
        Fix or replace the component behind the vulnerability named in the risk-weighted reason, then collect the scan again and run <code>enrich</code>. The scan record is in the evidence inventory.
        {% elif urgent_gaps %}
        Produce the evidence for the {{ urgent_gaps }} critical and high gap(s). They are listed first under Gaps, each with what to produce.
        {% elif bundle.gaps %}
        No critical or high gap is open. Review the {{ bundle.gaps | length }} remaining gap(s) under Gaps.
        {% elif verdict != "ready" %}
        Read the rationale of each control that is not met in the control list below.
        {% else %}
        This report asks for no action. Keep <code>bundle.json</code> with the release record; <code>sdlc-evidence verify bundle.json</code> prints its digest.
        {% endif %}
      </p>
    </div>
  </section>

  <div class="scores">
    <div class="score">
      <div class="label">Evidence coverage</div>
      <div class="value">{{ summary.evidence_coverage_score }}<span class="unit">/100</span></div>
      {{ meter(summary.evidence_coverage_score, "main") }}
      <p class="hint">Weighted share of the required and recommended evidence that was found.</p>
    </div>
    <div class="score">
      <div class="label">Confidence</div>
      <div class="value">{{ summary.confidence_score }}<span class="unit">/100</span></div>
      {{ meter(summary.confidence_score, "alt") }}
      <p class="hint">Average over the met, partial and waived controls: high 100, medium 66, low 33. A control backed by manually attested evidence counts one level lower.</p>
    </div>
    <div class="score">
      <div class="label">Controls</div>
      <div class="value">{{ summary.total_controls }}</div>
      <div class="meta">
        {{ summary.controls_met }} met · {{ summary.controls_partial }} partial · {{ summary.controls_missing }} missing · {{ summary.controls_waived }} waived · {{ summary.controls_not_applicable }} n/a
      </div>
      {% set segments = [("met", summary.controls_met), ("partial", summary.controls_partial), ("missing", summary.controls_missing), ("waived", summary.controls_waived), ("not_applicable", summary.controls_not_applicable)] %}
      {% set drawn = segments | sum(attribute=1) %}
      {% if drawn %}
      {% set cursor = namespace(x=0) %}
      <svg class="bar" viewBox="0 0 {{ drawn | int }} 1" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        {%- for name, count in segments -%}
        {%- if count -%}<rect class="seg-{{ name }}" x="{{ cursor.x | int }}" width="{{ count | int }}" height="1"/>{%- endif -%}
        {%- set cursor.x = cursor.x + count -%}
        {%- endfor -%}
      </svg>
      {% endif %}
    </div>
  </div>
</div>

<dl class="facts">
  <div class="fact">
    <dt class="name">Application</dt>
    <dd>
      <p class="fv">{{ bundle.application.name }}</p>
      <p class="meta"><code>{{ bundle.application.repository }}</code> · {{ bundle.application.environment }}</p>
    </dd>
  </div>
  <div class="fact">
    <dt class="name">Release</dt>
    <dd>
      <p class="fv">{{ bundle.release.release_id }}</p>
      <p class="meta">commit <code>{{ bundle.release.commit_sha }}</code>{% if bundle.release.branch %} · branch <code>{{ bundle.release.branch }}</code>{% endif %}</p>
    </dd>
  </div>
  {#- Which catalog produced the verdict belongs beside the verdict: the same
      evidence yields a different release status against a different control
      set, and a custom catalog is the case a reader most needs to notice. -#}
  {% if bundle.catalog %}
  <div class="fact">
    <dt class="name">Control catalog</dt>
    <dd>
      <p class="fv">{{ bundle.catalog.name }}</p>
      <p class="meta">
        {% if custom_catalog %}
        <strong class="flag">{{ icon("v-conditional") }}custom</strong> — not the catalog shipped with the tool
        {% else %}
        shipped with the tool
        {% endif %}
        · {{ bundle.catalog.control_count }} controls
        · <code>{{ bundle.catalog.sha256[:12] }}</code>
      </p>
    </dd>
  </div>
  {% endif %}
  {#- What ties this verdict to one build. An absent value is said, not hidden:
      a verdict with no artifact digest is not bound to an artifact. -#}
  <div class="fact provenance">
    <dt class="name">Release provenance</dt>
    <dd>
      <dl class="pairs">
        {% for label, value in [("tag", bundle.release.tag), ("artifact digest", bundle.release.artifact_digest), ("pipeline run", bundle.release.pipeline_run_id), ("build", bundle.release.build_id)] %}
        <div><dt>{{ label }}</dt><dd>{% if value %}<code>{{ value }}</code>{% else %}<span class="absent">not recorded</span>{% endif %}</dd></div>
        {% endfor %}
      </dl>
    </dd>
  </div>
</dl>

<nav class="toc" aria-label="On this page">
  <ul>
    {% if errors %}<li><a href="#inputs">Unreadable inputs <span class="n">{{ errors | length }}</span></a></li>{% endif %}
    {% if ignored_inputs is defined and ignored_inputs %}<li><a href="#unrecognized">Inputs not recognized <span class="n">{{ ignored_inputs | length }}</span></a></li>{% endif %}
    <li><a href="#gaps">Gaps <span class="n">{{ bundle.gaps | length }}</span></a></li>
    {% if exceptions_in_force %}<li><a href="#approved">Approved exceptions <span class="n">{{ exceptions_in_force | length }}</span></a></li>{% endif %}
    {% if exceptions_not_in_force %}<li><a href="#not-in-force">Exceptions not in force <span class="n">{{ exceptions_not_in_force | length }}</span></a></li>{% endif %}
    <li><a href="#controls">Controls <span class="n">{{ bundle.control_evaluations | length }}</span></a></li>
    <li><a href="#evidence">Evidence inventory <span class="n">{{ bundle.evidence | length }}</span></a></li>
  </ul>
</nav>

{% if errors %}
<section class="block" id="inputs">
<h2>Inputs that could not be read</h2>
<div class="callout">
  {{ icon("v-conditional") }}
  <p>
    <strong>{{ errors | length }} supplied input(s) failed to
    parse.</strong> A control below may read as <em>missing evidence</em> when the
    evidence was in fact provided and could not be ingested. Fix the inputs and
    re-run before treating any gap here as a real one.
  </p>
</div>
<div class="sheet" role="region" aria-label="Inputs that could not be read table" tabindex="0">
<table role="table">
  <thead role="rowgroup">
    <tr role="row">
      <th role="columnheader" scope="col">Input</th>
      <th role="columnheader" scope="col">Why it was not ingested</th>
    </tr>
  </thead>
  <tbody role="rowgroup">
    {% for error in errors %}
    <tr role="row">
      <td role="cell" class="wide"><span class="k" aria-hidden="true">Input</span><code>{{ error.path }}</code></td>
      <td role="cell" class="wide"><span class="k" aria-hidden="true">Why it was not ingested</span>{{ error.reason }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
</div>
</section>
{% endif %}

{% if ignored_inputs is defined and ignored_inputs %}
<section class="block" id="unrecognized">
<h2>Inputs not recognized</h2>
{#- Count only: this page does not show artifact file paths (owner decision,
    2026-11-13). The list is in report.md and in the run's console output. -#}
<p class="lede">{{ ignored_inputs | length }} file(s) in the artifact directories matched no parser and were not collected. They are not errors, but a control may be missing evidence that one of them was meant to carry. The file list is in <code>report.md</code> and in the console output of the run.</p>
</section>
{% endif %}

<section class="block" id="gaps">
<h2>Gaps</h2>
{% if bundle.gaps %}
<p class="lede">Most critical first. A critical gap makes the release <code>not_ready</code>; a high gap makes it <code>conditional</code> at best.</p>
<div class="sheet" role="region" aria-label="Gaps table" tabindex="0">
<table role="table">
  <thead role="rowgroup">
    <tr role="row">
      <th role="columnheader" scope="col">Control</th>
      <th role="columnheader" scope="col">Evidence type</th>
      <th role="columnheader" scope="col">Description</th>
      <th role="columnheader" scope="col">What to produce</th>
    </tr>
  </thead>
  {% for level in levels %}
  {% set group = bundle.gaps | selectattr("criticality", "equalto", level) | list %}
  {% if group %}
  <tbody role="rowgroup">
    <tr role="row" class="group">
      <th role="rowheader" scope="rowgroup" colspan="4" class="wide">{{ level_mark(level) }}<span class="n">{{ group | length }}</span></th>
    </tr>
    {% for gap in group %}
    <tr role="row">
      <td role="cell" class="c-ref"><span class="k" aria-hidden="true">Control</span>{{ control_link(gap.control_id) }}</td>
      <td role="cell"><span class="k" aria-hidden="true">Evidence type</span>{{ gap.evidence_type.value if gap.evidence_type else "-" }}</td>
      <td role="cell" class="wide"><span class="k" aria-hidden="true">Description</span>{{ ticked(gap.description) }}</td>
      <td role="cell" class="wide"><span class="k" aria-hidden="true">What to produce</span>{{ ticked(gap.remediation) if gap.remediation else "-" }}</td>
    </tr>
    {% endfor %}
  </tbody>
  {% endif %}
  {% endfor %}
</table>
</div>
{% else %}
<p class="empty">No gaps detected.</p>
{% endif %}
</section>

{% if exceptions_in_force %}
<section class="block" id="approved">
<h2>Approved exceptions</h2>
<div class="sheet" role="region" aria-label="Approved exceptions table" tabindex="0">
<table role="table">
  <thead role="rowgroup">
    <tr role="row">
      <th role="columnheader" scope="col">Exception</th>
      <th role="columnheader" scope="col">Control</th>
      <th role="columnheader" scope="col">Approver</th>
      <th role="columnheader" scope="col">Expires</th>
      <th role="columnheader" scope="col">Reference</th>
    </tr>
  </thead>
  <tbody role="rowgroup">
    {% for exception in exceptions_in_force %}
    <tr role="row" id="exc-{{ loop.index }}">
      <th role="rowheader" scope="row" class="wide c-id"><span class="k" aria-hidden="true">Exception</span><code>{{ exception.exception_id }}</code></th>
      <td role="cell" class="c-id"><span class="k" aria-hidden="true">Control</span>{{ control_link(exception.control_id) }}</td>
      <td role="cell" class="free c-who"><span class="k" aria-hidden="true">Approver</span>{{ exception.approver }}</td>
      <td role="cell"><span class="k" aria-hidden="true">Expires</span>{{ exception.expires_at.isoformat() }}</td>
      <td role="cell" class="free"><span class="k" aria-hidden="true">Reference</span>{{ exception.reference or "-" }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
</div>
</section>
{% endif %}

{% if exceptions_not_in_force %}
<section class="block" id="not-in-force">
<h2>Exceptions not in force</h2>
<p class="lede">Supplied with the evidence but not applied to this release.</p>
<div class="sheet" role="region" aria-label="Exceptions not in force table" tabindex="0">
<table role="table">
  <thead role="rowgroup">
    <tr role="row">
      <th role="columnheader" scope="col">Exception</th>
      <th role="columnheader" scope="col">Control</th>
      <th role="columnheader" scope="col">Approver</th>
      <th role="columnheader" scope="col">Expires</th>
      <th role="columnheader" scope="col">Why it does not apply</th>
    </tr>
  </thead>
  <tbody role="rowgroup">
    {% for exception, reason in exceptions_not_in_force %}
    <tr role="row">
      <th role="rowheader" scope="row" class="wide c-id"><span class="k" aria-hidden="true">Exception</span><code>{{ exception.exception_id }}</code></th>
      <td role="cell" class="c-id"><span class="k" aria-hidden="true">Control</span>{{ control_link(exception.control_id) }}</td>
      <td role="cell" class="free c-who"><span class="k" aria-hidden="true">Approver</span>{{ exception.approver }}</td>
      <td role="cell"><span class="k" aria-hidden="true">Expires</span>{{ exception.expires_at.isoformat() }}</td>
      <td role="cell" class="wide"><span class="k" aria-hidden="true">Why it does not apply</span>{{ reason }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
</div>
</section>
{% endif %}

<section class="block" id="controls">
<h2>Controls</h2>
<div class="sheet" role="region" aria-label="Controls table" tabindex="0">
<table role="table">
  <thead role="rowgroup">
    <tr role="row">
      <th role="columnheader" scope="col">Control</th>
      <th role="columnheader" scope="col">Framework</th>
      <th role="columnheader" scope="col">Status</th>
      <th role="columnheader" scope="col">Criticality</th>
      <th role="columnheader" scope="col">Confidence</th>
      <th role="columnheader" scope="col">Evidence</th>
    </tr>
  </thead>
  <tbody role="rowgroup">
    {% for evaluation in bundle.control_evaluations %}
    {% set status = evaluation.evaluation_status.value %}
    <tr role="row" id="ctl-{{ loop.index }}">
      <th role="rowheader" scope="row" class="c-main wide">
        <code>{{ evaluation.control_id }}</code>
        <span class="name">{{ evaluation.control_name }}</span>
        <details{% if status != "met" %} open{% endif %}>
          <summary>Rationale</summary>
          <p>{{ evaluation.rationale }}</p>
        </details>
      </th>
      <td role="cell"><span class="k" aria-hidden="true">Framework</span>{{ evaluation.framework.value }}</td>
      <td role="cell"><span class="k" aria-hidden="true">Status</span><span class="pill pill-{{ status }}">{{ icon(control_glyph.get(status, "dot")) }}{{ status }}</span></td>
      <td role="cell"><span class="k" aria-hidden="true">Criticality</span>{{ level_mark(evaluation.criticality.value) }}</td>
      <td role="cell"><span class="k" aria-hidden="true">Confidence</span>{{ evaluation.confidence.value }}</td>
      <td role="cell" class="c-ref wide refs"><span class="k" aria-hidden="true">Evidence</span>
        {%- if evaluation.evidence_refs -%}
          {%- for ref in evaluation.evidence_refs -%}
          {%- if ref in evidence_row %}<a class="ref" href="#ev-{{ evidence_row[ref] }}"><code>{{ ref }}</code></a>{% else %}<code>{{ ref }}</code>{% endif -%}
          {%- endfor -%}
        {%- else %}-{% endif -%}
        {%- for ref in evaluation.exception_refs if status == "waived" %}
        <span class="waiver">waived by {% if ref in exception_row %}<a class="ref" href="#exc-{{ exception_row[ref] }}"><code>{{ ref }}</code></a>{% else %}<code>{{ ref }}</code>{% endif %}</span>
        {%- endfor %}
      </td>
    </tr>
    {% endfor %}
  </tbody>
</table>
</div>
</section>

<section class="block" id="evidence">
<h2>Evidence inventory</h2>
<div class="sheet" role="region" aria-label="Evidence inventory table" tabindex="0">
<table role="table">
  <thead role="rowgroup">
    <tr role="row">
      <th role="columnheader" scope="col">ID</th>
      <th role="columnheader" scope="col">Type</th>
      <th role="columnheader" scope="col">Producer</th>
      <th role="columnheader" scope="col">Status</th>
      <th role="columnheader" scope="col">Confidence</th>
      <th role="columnheader" scope="col">Subject</th>
    </tr>
  </thead>
  <tbody role="rowgroup">
    {% for item in bundle.evidence %}
    {% set tone = evidence_tone.get(item.status.value, "muted") %}
    <tr role="row" id="ev-{{ loop.index }}">
      <th role="rowheader" scope="row" class="c-ref wide">
        <code>{{ item.evidence_id }}</code>
        {% if item.evidence_id in supports %}
        <span class="supports">supports {% for control_id in supports[item.evidence_id] %}{{ control_link(control_id) }}{% if not loop.last %} {% endif %}{% endfor %}</span>
        {% endif %}
      </th>
      <td role="cell"><span class="k" aria-hidden="true">Type</span>{{ item.evidence_type.value }}</td>
      {#- A manually attested item names the tool the operator says produced it,
          so this column alone reads as though the tool was collected from. -#}
      <td role="cell" class="free"><span class="k" aria-hidden="true">Producer</span>{{ item.producer }}{% if item.manual %} <span class="manual">(manual attestation)</span>{% endif %}</td>
      <td role="cell"><span class="k" aria-hidden="true">Status</span><span class="pill" data-tone="{{ tone }}">{{ icon(tone_glyph.get(tone, "dot")) }}{{ item.status.value }}</span></td>
      <td role="cell"><span class="k" aria-hidden="true">Confidence</span>{{ item.confidence.value }}</td>
      <td role="cell" class="wide"><span class="k" aria-hidden="true">Subject</span><code>{{ item.subject_ref }}</code></td>
    </tr>
    {% endfor %}
  </tbody>
</table>
</div>
</section>
</main>

<footer>
  <p>Produced by Secure SDLC Evidence Collector{% if collector_version is defined and collector_version %} {{ collector_version }}{% endif %} · bundle schema {{ bundle.bundle_version }}</p>
  <p>This page is a rendering of <code>bundle.json</code>, which is the record.{% if not (bundle_digest is defined and bundle_digest) %} <code>sdlc-evidence verify bundle.json</code> prints its digest.{% endif %}</p>
  {% if bundle_digest is defined and bundle_digest %}
  <dl class="kv">
    <dt>bundle digest</dt><dd><code>{{ bundle_digest }}</code></dd>
    <dt>check it with</dt><dd><code>sdlc-evidence verify bundle.json --expected {{ bundle_digest }}</code></dd>
  </dl>
  {% endif %}
</footer>
</div>
</body>
</html>
